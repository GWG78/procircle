generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id          Int       @id @default(autoincrement())
  shopDomain  String    @unique
  accessToken String
  scope        String?
  installed    Boolean   @default(false)
  uninstalledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  settings     ShopSettings?
  campaigns   Campaign[]
  memberShopifyLinks MemberShopifyLink[]
}

model Campaign {
  id                    Int          @id @default(autoincrement())
  shopId                Int
  shop                  Shop         @relation(fields: [shopId], references: [id])

  name                  String
  slug                  String       @unique

  discountType          String       @default("percentage")
  discountValue         Float

  maxRedemptionsPerUser Int?         @default(1)
  maxRedemptions        Int?

  targetAudience        String       @default("all")

  // "active" | "paused" | "ended". "Draft" and "Cap Reached" are derived
  // display states, not stored here — Draft = status "active" with a future
  // startsAt, Cap Reached = status "active" with confirmed redemptions at
  // maxRedemptions. See routes/campaigns.mjs deriveStatus().
  status                String       @default("active")
  pausedAt              DateTime?
  endedAt               DateTime?
  // Set only when the campaign auto-ended because its Shopify discount was
  // deleted outside the app (see webhooks/discountDeleted.mjs). Null for a
  // manual End Campaign action — distinguishes the two in logs/DB.
  endedReason            String?
  startsAt              DateTime?
  validForDays          Int          @default(30)

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  redemptions           Redemption[]
  filters               CampaignFilter[]
  shopifySegmentId      String?

  discountCode          String?
  discountLink          String?
  shopifyDiscountId     String?

  // WordPress "campaign" CPT post ID, cached after creation so future
  // pause/resume/end actions can update the WP post without re-querying by
  // slug. Null until the WP-side create call succeeds (never blocks
  // campaign creation — see routes/campaigns.mjs).
  wpPostId              Int?
}

// Bridges a Google Sheet brand signup (BrandID, generated in
// onBrandSheetChange) to the Shopify shop that later installs the app.
// Deliberately its own table rather than a column on Shop: a brand signs up
// on the sheet — and BrandID exists — before they've necessarily installed
// the Shopify app, so a Shop row may not exist yet at sync time. Populated
// by POST /api/brands, called from Apps Script's BrandSync.js.
model Brand {
  id             Int      @id @default(autoincrement())
  brandId        String   @unique // e.g. "BRD-FO-1A2B", from generateBrandId() in UserHandler.js
  shopDomain     String   @unique // e.g. "forwardoutdoor.myshopify.com"

  // WordPress "brand" CPT post ID, cached on first lookup (GET
  // /wp-json/wp/v2/brand?slug={brandId.toLowerCase()}) so later campaign
  // creations don't need to re-resolve it every time.
  wpBrandPostId  Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Redemption {
  id               Int       @id @default(autoincrement())
  campaignId       Int
  campaign         Campaign  @relation(fields: [campaignId], references: [id])

  memberId         Int
  member           Member    @relation(fields: [memberId], references: [id])
  status           String    @default("pending")

  accessGrantedAt  DateTime  @default(now())
  accessExpiresAt  DateTime?
  reminderSentAt   DateTime?

  shopifyOrderId   String?
  orderAmount      Float?
  orderCompletedAt DateTime?
}

model Member {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  firstName       String?
  lastName        String?

  role            String
  country         String?
  resort          String?

  yearsExperience Int?
  socialLinks     Json?
  qualifications  String[]  @default([])

  verified        Boolean   @default(false)
  verifiedAt      DateTime?

  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions     Redemption[]
  shopifyLinks    MemberShopifyLink[]
}

model MemberShopifyLink {
  id                Int     @id @default(autoincrement())
  memberId          Int
  member            Member  @relation(fields: [memberId], references: [id])
  shopId            Int
  shop              Shop    @relation(fields: [shopId], references: [id])
  shopifyCustomerId String

  @@unique([memberId, shopId])
}

model CampaignFilter {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  filterType String
  value      String

  @@index([campaignId])
}

model ShopSettings {
  id                 Int       @id @default(autoincrement())
  shopId             Int       @unique
  shop               Shop      @relation(fields: [shopId], references: [id])

  categories         String[]  @default([]) // product category handles

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}